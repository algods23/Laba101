{
  "name": "laba101-mobile",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:debug": "npm run build && npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run build && npm run cap:sync && cd android && gradlew.bat assembleRelease",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy.ps1",
    "deploy:fast": "powershell -ExecutionPolicy Bypass -File deploy.ps1 -SkipBuild"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "typescript": "^5.8.3",
    "vite": "^7.0.7"
  }
}
